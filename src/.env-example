# Optional: explicit path to .env (otherwise ".env" then "../.env" is tried)
# DOTENV_PATH=.env

GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Optional: path to saved OAuth token (default: gmail-token.json in current directory)
# GMAIL_TOKEN_PATH=gmail-token.json
# Optional: must match an authorized redirect URI in Google Cloud (default below)
# GMAIL_OAUTH_REDIRECT_URL=http://127.0.0.1:8765/
#
# After adding gmail.send or calendar.readonly in Google Cloud OAuth consent: delete
# gmail-token.json (or your GMAIL_TOKEN_PATH) and sign in again so the token
# includes the new scopes. Also enable Google Calendar API in the Cloud project.

# --- Family digest (use CLI flag -digest) ---
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# Comma-separated list of recipients, e.g. "a@b.com,c@d.com"
DIGEST_TO_EMAIL=
# DIGEST_SUBJECT=Family update
# DIGEST_WEEKS=1
# DIGEST_LANGUAGE=sv-SE
# GMAIL_DIGEST_QUERY=newer_than:14d
# Comma-separated Gmail label names (UI names). Digest mode runs one list per label
# (base query above + each label), up to -n messages per label, then merges and summarizes together.
# GMAIL_DIGEST_LABELS=Work,Family
# Shared family calendar ID (usually the owner's email). Events from now through DIGEST_WEEKS.
# GMAIL_CALENDAR_ID=tedochjohanna@gmail.com
# Child profiles for school attribution (DIGEST_CHILD_N_NAME required; stop at first missing N; max 8).
# LABELS: match against Source Label: line. CLASS_CODES: match in Subject/From/body.
# DIGEST_CHILD_1_NAME=Annie
# DIGEST_CHILD_1_LABELS=0---kidsen-annie,kidsen-annie
# DIGEST_CHILD_1_CLASS_CODES=F2017,F17,17
# DIGEST_CHILD_2_NAME=Oscar
# DIGEST_CHILD_2_LABELS=0---kidsen-oscar,kidsen-oscar
# DIGEST_CHILD_2_CLASS_CODES=P2014,14e
# DIGEST_MAX_BODY_CHARS=4000
