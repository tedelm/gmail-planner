# Optional: explicit path to .env (otherwise ".env" then "../.env" is tried)
# DOTENV_PATH=.env

GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Optional: path to saved OAuth token (default: gmail-token.json in current directory)
# GMAIL_TOKEN_PATH=gmail-token.json
# Optional: must match an authorized redirect URI in Google Cloud (default below)
# GMAIL_OAUTH_REDIRECT_URL=http://127.0.0.1:8765/
#
# After adding the "gmail.send" scope in Google Cloud OAuth consent: delete
# gmail-token.json (or your GMAIL_TOKEN_PATH) and sign in again so the token
# includes send permission.

# --- Family digest (use CLI flag -digest) ---
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# Comma-separated list of recipients, e.g. "a@b.com,c@d.com"
DIGEST_TO_EMAIL=
# DIGEST_SUBJECT=Family update
# DIGEST_WEEKS=1
# DIGEST_LANGUAGE=sv-SE
# GMAIL_DIGEST_QUERY=newer_than:14d
# Comma-separated Gmail label names (UI names); AND with GMAIL_DIGEST_QUERY / -q (label: search terms).
# GMAIL_DIGEST_LABELS=Work,Family
# DIGEST_MAX_BODY_CHARS=4000
